 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🧠 ReAct Agent using LangGraph + Gemini 1.5 Flash\n",
    "This notebook demonstrates how to build a basic ReAct (Reason+Act) agent using LangGraph and the Gemini 1.5 Flash model."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ✅ Install Required Libraries\n",
    "!pip install langgraph langchain langchain-google-genai python-dotenv"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ✅ Setup Environment Variable\n",
    "import os\n",
    "from dotenv import load_dotenv\n",
    "load_dotenv()  # Make sure you have .env file with GOOGLE_API_KEY\n",
    "\n",
    "# You can also set the key manually like this:\n",
    "# os.environ['GOOGLE_API_KEY'] = 'your_key_here'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ✅ Define Tools\n",
    "from langchain.tools import tool\n",
    "\n",
    "@tool\n",
    "def search(query: str) -> str:\n",
    "    """Fake search tool to simulate looking up information"""\n",
    "    fake_db = {\n",
    "        "capital of france": "Paris",\n",
    "        "weather in paris": "Today it’s sunny in Paris with 25°C."\n",
    "    }\n",
    "    return fake_db.get(query.lower(), "No info found")\n",
    "\n",
    "@tool\n",
    "def calculator(expression: str) -> str:\n",
    "    """Simple calculator tool"""\n",
    "    try:\n",
    "        return str(eval(expression))\n",
    "    except:\n",
    "        return "Invalid expression""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ✅ Build ReAct Agent Graph\n",
    "from langgraph.graph import StateGraph, END\n",
    "from langchain_core.runnables import RunnableLambda\n",
    "from langchain.agents import create_react_agent, AgentExecutor\n",
    "from langchain_google_genai import ChatGoogleGenerativeAI\n",
    "from langchain.agents import Tool\n",
    "\n",
    "def build_agent_graph():\n",
    "    llm = ChatGoogleGenerativeAI(\n",
    "        model="gemini-1.5-flash",\n",
    "        temperature=0.4,\n",
    "        google_api_key=os.environ["GOOGLE_API_KEY"]\n",
    "    )\n",
    "\n",
    "    tools = [\n",
    "        Tool(name="search", func=search, description="Use this for looking up factual questions."),\n",
    "        Tool(name="calculator", func=calculator, description="Use this to calculate math expressions.")\n",
    "    ]\n",
    "\n",
    "    agent = create_react_agent(llm, tools)\n",
    "    executor = AgentExecutor(agent=agent, tools=tools, verbose=True, handle_parsing_errors=True)\n",
    "\n",
    "    def invoke_agent(state):\n",
    "        input_text = state["input"]\n",
    "        result = executor.invoke({"input": input_text})\n",
    "        return {"input": input_text, "output": result["output"]}\n",
    "\n",
    "    builder = StateGraph()\n",
    "    builder.add_node("react_agent", RunnableLambda(invoke_agent))\n",
    "    builder.set_entry_point("react_agent")\n",
    "    builder.set_finish_point(END)\n",
    "\n",
    "    return builder.compile()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ✅ Run the ReAct Agent\n",
    "graph = build_agent_graph()\n",
    "question = "What is the capital of France and what’s the weather in that city?"\n",
    "input_state = {"input": question}\n",
    "result = graph.invoke(input_state)\n",
    "\n",
    "print("\U0001F9E0 Final Output:")\n",
    "print(result["output"])"
   ]
  }
 ],
